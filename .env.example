# JobPilot environment variables.
# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- LLM: Groq (primary) ---
GROQ_API_KEY=
# llama-3.3-70b-versatile was retired from the free/developer tier (Aug 2026).
# openai/gpt-oss-120b is the recommended self-serve replacement; openai/gpt-oss-20b is cheaper.
GROQ_MODEL=openai/gpt-oss-120b

# --- LLM: Ollama (local fallback) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Database: Neon (Postgres) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- Google Drive (service account) ---
# Path to the service-account JSON file, or the JSON content inline.
GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
DRIVE_FOLDER_ID=
# User OAuth (recommended for a personal Google account: a service account has no
# storage quota). Run `jobpilot auth-drive` once and store the printed token here.
# When set, OAuth is used instead of the service account.
DRIVE_REFRESH_TOKEN=
# OAuth client for Drive. Optional: defaults to GMAIL_CLIENT_ID/SECRET below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Mail provider selection: outlook (default) | gmail ---
MAIL_PROVIDER=outlook

# --- Outlook / Microsoft Graph (primary mailer) ---
# Register an app in Azure AD with delegated permission Mail.Send.
GRAPH_CLIENT_ID=
# Tenant is usually "consumers" for personal Hotmail/Outlook accounts.
GRAPH_TENANT_ID=consumers
# Obtained by running `jobpilot auth-mail`; store as a secret.
GRAPH_REFRESH_TOKEN=
MAIL_FROM_ADDRESS=

# --- Gmail (secondary mailer) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Adzuna (optional fetcher, feature-flagged) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Pipeline behaviour ---
MIN_SCORE=70
DAILY_APPLICATION_LIMIT=5
# Default language used only when explicitly enabled in config.yaml (es | en).
DEFAULT_LANGUAGE=es
